# --- LLM --------------------------------------------------------------
# Google Gemini API key (free tier: https://aistudio.google.com/apikey). Only used server-side.
GOOGLE_GENERATIVE_AI_API_KEY=
# Model used by the agent (Mastra model router format, "provider/model").
# Any supported provider works, e.g. anthropic/claude-haiku-5-5 with ANTHROPIC_API_KEY.
AGENT_MODEL=google/gemini-2.5-flash

# --- Database (docker compose up -d) ------------------------------------
DATABASE_URL=postgres://nexo:nexo@localhost:5433/nexo_assist

# --- Auth -----------------------------------------------------------------
# Secret used to sign the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Ticket service (simulated legacy system, served by this same app) -------
TICKETS_SERVICE_URL=http://localhost:3000/api/tickets-service
# Shared secret between the BFF/agent and the ticket service.
TICKETS_SERVICE_TOKEN=dev-tickets-token
# Probability (0-1) that a ticket-service request fails with 503, to simulate the flaky legacy system.
TICKETS_FAILURE_RATE=0.1
# Extra latency (ms) added to each ticket-service request.
TICKETS_LATENCY_MS=150

# --- Cost / abuse limits -----------------------------------------------------
# Max agent turns per user per hour (the 30 messages/session limit is fixed by the PRD).
RATE_LIMIT_PER_HOUR=60
